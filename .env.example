# ─────────────────────────────────────────────────────────────
# CloudTech Legal Suite — The Counsel
# Frontend environment (Vite). Copy to `.env.local` and fill in.
# Backend is entirely Supabase — no custom API URL is used.
# ─────────────────────────────────────────────────────────────

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public key (safe for the browser; RLS enforces access)
VITE_SUPABASE_ANON_KEY=

# Paystack PUBLIC key only (safe for the browser). Leaving this unset keeps
# every "Subscribe"/"Upgrade" button in a clear "not configured yet" state
# instead of attempting checkout. The SECRET key is never set here — it's an
# Edge Function secret only: `supabase secrets set PAYSTACK_SECRET_KEY=sk_...`
VITE_PAYSTACK_PUBLIC_KEY=

# Sentry client-side error monitoring. Leaving this unset keeps monitoring
# fully disabled (initSentry() is a no-op) — safe to leave blank for local
# dev. Get a DSN from sentry.io → your project → Settings → Client Keys.
VITE_SENTRY_DSN=

# 'development' | 'staging' | 'production' — set per Vercel environment so
# Sentry can tell Staging and Production apart (both build in Vite's
# 'production' mode, so MODE alone can't distinguish them). Leave unset
# locally; falls back to Vite's MODE.
VITE_APP_ENV=
